      "takes": [
        "s44-ef5bc4_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s31-voice",
      "line": "विक्रम, तेरी स्कॉलरशिप… असल में मेरी ज़मीन थी।",
      "lang": "hi",
      "takes": [
        "s31-4f4fce-v_384p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s32-voice",
      "line": "Sunny, तेरी दुकान का कर्ज़ मैंने चुपचाप चुकाया था।",
      "lang": "hi",
      "takes": [
