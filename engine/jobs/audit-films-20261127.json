  "checks": [
    {
      "id": "baba-ka-baksa:s04",
      "line": "अब आए हो? अंतिम संस्कार तो कल ही हो गया।",
      "lang": "hi",
      "takes": [
        "s04-0cf634_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s05",
      "line": "फ़्लाइट नहीं मिली, Sunny… मैं कोशिश कर रहा था।",
      "lang": "hi",
      "takes": [
        "s05-d4c541_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s06",
      "line": "आठ साल से कोशिश ही तो कर रहे हो।",
      "lang": "hi",
      "takes": [
        "s06-ffc6f1_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s07",
      "line": "बेटा, कम से कम आज तो मत लड़ो।",
      "lang": "hi",
      "takes": [
        "s07-64c59b_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s08",
      "line": "बाबूजी की सारी जमापूंजी इसी बक्से में है।",
      "lang": "hi",
      "takes": [
        "s08-baa71e_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s09",
      "line": "तुम्हें बाबूजी नहीं, उनका पैसा याद आया।",
      "lang": "hi",
      "takes": [
        "s09-f6a553_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s10",
      "line": "मकान बेचेंगे, आधा-आधा। मुझे Mumbai वापस जाना है।",
      "lang": "hi",
      "takes": [
        "s10-8fdbc5_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s11",
      "line": "ये मकान नहीं बिकेगा। बाबूजी की सांसें हैं इसमें।",
      "lang": "hi",
      "takes": [
        "s11-ed7c0a_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s13",
      "line": "हाँ, ब्रोकर से बात करो, Sunday तक डील पक्की।",
      "lang": "hi",
      "takes": [
        "s13-ad869f_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s18",
      "line": "चोर की तरह रात में? शर्म नहीं आती?",
      "lang": "hi",
      "takes": [
        "s18-bc988b_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s19",
      "line": "मैंने कभी कुछ नहीं माँगा। पढ़ाई भी स्कॉलरशिप से की।",
      "lang": "hi",
      "takes": [
        "s19-5bd793_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s20",
      "line": "और मैंने दुकान अपने दम पर खड़ी की है!",
      "lang": "hi",
      "takes": [
        "s20-b6c13a_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s20b",
      "line": "चाबी कहाँ है? तुमने ही छुपाई है ना?",
      "lang": "hi",
      "takes": [
        "s20b-cdcfbd_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s20c",
      "line": "झूठ! बाबूजी ने चाबी किसी को नहीं दी।",
      "lang": "hi",
      "takes": [
        "s20c-b071ba_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s23",
      "line": "बस! तुम्हारे बाबूजी यही देखने के लिए जिए थे?",
      "lang": "hi",
      "takes": [
        "s23-c2f81c_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s25",
      "line": "चाबी हमेशा यहीं थी… Sunny के खिलौने में।",
      "lang": "hi",
      "takes": [
        "s25-fdc472_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s27",
      "line": "इसीलिए बाबूजी ने इसे कभी फेंकने नहीं दिया…",
      "lang": "hi",
      "takes": [
        "s27-e238e4_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s30",
      "line": "पैसे… पैसे तो हैं ही नहीं।",
      "lang": "hi",
      "takes": [
        "s30-83440f_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s37",
      "line": "मुझे माफ़ कर दे, छोटे… मैं बहुत दूर चला गया था।",
      "lang": "hi",
      "takes": [
        "s37-c5d648_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s38",
      "line": "भैया… घर आ गए, बस यही काफ़ी है।",
      "lang": "hi",
      "takes": [
        "s38-646c00_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s41",
      "line": "डील कैंसल करो। ये घर नहीं बिकेगा।",
      "lang": "hi",
      "takes": [
        "s41-11e6aa_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "baba-ka-baksa:s44",
      "line": "मेरे लिए एक Like तो बनता है… और Subscribe करना मत भूलिए!",
