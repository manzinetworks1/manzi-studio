  "checks": [
    {
      "id": "s03",
      "line": "तेरह दिन हो गए… आज बाबूजी का बक्सा खोलना है।",
      "lang": "hi",
      "takes": [
        "s03-984c70_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s04",
      "line": "चाबी कहाँ है, अम्मा?",
      "lang": "hi",
      "takes": [
        "s04-a0835b_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s05",
      "line": "उन्होंने किसी को नहीं दी।",
      "lang": "hi",
      "takes": [
        "s05-c4c357_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s07",
      "line": "तुम्हें बाबूजी नहीं, उनका पैसा याद आया।",
      "lang": "hi",
      "takes": [
        "s07-56ebc9_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s08",
      "line": "आठ साल बाद आया हूँ, ताने सुनने नहीं।",
      "lang": "hi",
      "takes": [
        "s08-9c94fc_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s09",
      "line": "आठ साल से कोशिश ही तो कर रहे हो।",
      "lang": "hi",
      "takes": [
        "s09-d6eafd_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s10",
      "line": "मकान बेचेंगे, आधा-आधा। मुझे Mumbai वापस जाना है।",
      "lang": "hi",
      "takes": [
        "s10-2cb60f_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s13",
      "line": "ये मकान नहीं बिकेगा। बाबूजी की सांसें हैं इसमें।",
      "lang": "hi",
      "takes": [
        "s13-05495d_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s14",
      "line": "बाबूजी की सारी जमापूंजी इसी बक्से में है।",
      "lang": "hi",
      "takes": [
        "s14-141001_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s15",
      "line": "चाबी तुमने ही छुपाई है ना?",
      "lang": "hi",
      "takes": [
        "s15-69c26c_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s16",
      "line": "झूठ! बाबूजी ने चाबी किसी को नहीं दी।",
      "lang": "hi",
      "takes": [
        "s16-c351a9_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s17",
      "line": "मैंने कभी कुछ नहीं माँगा। पढ़ाई भी स्कॉलरशिप से की।",
      "lang": "hi",
      "takes": [
        "s17-5de61c_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s18",
      "line": "और मैंने दुकान अपने दम पर खड़ी की है!",
      "lang": "hi",
      "takes": [
        "s18-d05fb0_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s20",
      "line": "बस! तुम्हारे बाबूजी यही देखने के लिए जिए थे?",
      "lang": "hi",
      "takes": [
        "s20-ce737d_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s25",
      "line": "चाबी हमेशा यहीं थी… Sunny के खिलौने में।",
      "lang": "hi",
      "takes": [
        "s25-65b686_544p.mp4"
      ],
      "base": null
    },
    {
      "id": "s27",
      "line": "इसीलिए बाबूजी ने इसे कभी फेंकने नहीं दिया…",
      "lang": "hi",
      "takes": [
        "s27-7e7bed_544p.mp4"
      ],
      "base": null
    },
    {
